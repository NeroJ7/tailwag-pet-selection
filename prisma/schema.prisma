generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model cart_items {
  id         String   @id
  cart_id    String
  product_id String
  quantity   Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, product_id])
}

model carts {
  id         String       @id
  user_id    String       @unique
  created_at DateTime     @default(now())
  updated_at DateTime
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model health_records {
  id            String    @id
  pet_id        String
  record_type   String
  title         String
  description   String?
  record_date   DateTime
  next_due_date DateTime?
  veterinarian  String?
  clinic_name   String?
  document_urls String[]  @default([])
  created_at    DateTime  @default(now())
  pets          pets      @relation(fields: [pet_id], references: [id], onDelete: Cascade)
}

model order_items {
  id              String   @id
  order_id        String
  product_id      String
  quantity        Int
  price           Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now())
  discount_amount Decimal? @default(0) @db.Decimal(10, 2)
  productImage    String?
  productName     String?
  subtotal        Decimal? @default(0) @db.Decimal(10, 2)
  orders          orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  products        products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
}

model orders {
  id               String        @id
  user_id          String
  order_number     String        @unique
  status           String        @default("pending")
  total_amount     Decimal       @db.Decimal(10, 2)
  shipping_address Json?
  payment_id       String?       @unique
  payment_method   String?
  paid_at          DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime
  cancel_reason    String?
  cancelled_at     DateTime?
  coupon_code      String?
  delivered_at     DateTime?
  discount_amount  Decimal?      @default(0) @db.Decimal(10, 2)
  notes            String?
  shipped_at       DateTime?
  shipping_fee     Decimal?      @default(0) @db.Decimal(10, 2)
  order_items      order_items[]
  users            users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at], map: "idx_orders_created")
  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user")
}

model pet_preferences {
  id               String   @id
  pet_id           String
  category         String
  item_id          String?
  preference_score Int?
  notes            String?
  created_at       DateTime @default(now())
  pets             pets     @relation(fields: [pet_id], references: [id], onDelete: Cascade)
}

model pets {
  id                      String                    @id
  user_id                 String
  name                    String
  species                 String
  breed                   String?
  gender                  String?
  birthday                DateTime?
  weight                  Float?
  photoUrls               String[]                  @default([])
  microchip_id            String?
  is_neutered             Boolean                   @default(false)
  created_at              DateTime                  @default(now())
  updated_at              DateTime
  health_records          health_records[]
  pet_preferences         pet_preferences[]
  users                   users                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product_recommendations product_recommendations[]
}

model product_categories {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  products    products[]
}

model product_recommendations {
  id                    Int       @id @default(autoincrement())
  user_id               String?   @db.VarChar(255)
  pet_id                String?   @db.VarChar(255)
  product_id            String?   @db.VarChar(255)
  recommendation_score  Decimal?  @db.Decimal(5, 2)
  recommendation_reason String?
  is_clicked            Boolean?  @default(false)
  is_purchased          Boolean?  @default(false)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  pets                  pets?     @relation(fields: [pet_id], references: [id], onUpdate: NoAction)
  products              products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([pet_id], map: "idx_product_recommendations_pet")
  @@index([user_id], map: "idx_product_recommendations_user")
}

model products {
  id                      String                    @id @db.VarChar(255)
  product_code            String?                   @unique @db.VarChar(255)
  name                    String                    @db.VarChar(255)
  brand                   String?                   @db.VarChar(100)
  category_id             Int?
  category_name           String?                   @db.VarChar(100)
  price                   Decimal                   @db.Decimal(10, 2)
  images                  String[]
  sourcing_url            String?
  selection_reason        String?
  tag                     String?                   @db.VarChar(100)
  margin                  String?                   @db.VarChar(50)
  voc_highlights          String[]
  description             String?
  specs                   Json?
  reviews                 Json?
  is_active               Boolean?                  @default(true)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  cart_items              cart_items[]
  order_items             order_items[]
  product_recommendations product_recommendations[]
  product_categories      product_categories?       @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category_name], map: "idx_products_category")
  @@index([price], map: "idx_products_price")
}

model user_activities {
  id            String   @id
  user_id       String?
  pet_id        String?
  activity_type String
  item_id       String?
  metadata      Json?
  created_at    DateTime @default(now())
}

model users {
  id                      String                    @id
  email                   String                    @unique
  name                    String?
  password_hash           String
  avatar_url              String?
  role                    String                    @default("user") @db.VarChar(20)
  created_at              DateTime                  @default(now())
  updated_at              DateTime
  carts                   carts?
  orders                  orders[]
  pets                    pets[]
  product_recommendations product_recommendations[]
}
