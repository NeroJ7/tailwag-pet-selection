generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  name                    String?
  passwordHash            String                    @map("password_hash")
  avatarUrl               String?                   @map("avatar_url")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  pets                    Pet[]
  product_recommendations product_recommendations[]
  orders                  Order[] // 添加这一行

  @@map("users")
}

model Pet {
  id                      String                    @id @default(uuid())
  userId                  String                    @map("user_id")
  name                    String
  species                 String
  breed                   String?
  gender                  String?
  birthday                DateTime?
  weight                  Float?
  photoUrls               String[]                  @default([])
  microchipId             String?                   @map("microchip_id")
  isNeutered              Boolean                   @default(false) @map("is_neutered")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  healthRecords           HealthRecord[]
  preferences             PetPreference[]
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product_recommendations product_recommendations[]

  @@map("pets")
}

model HealthRecord {
  id           String    @id @default(uuid())
  petId        String    @map("pet_id")
  recordType   String    @map("record_type")
  title        String
  description  String?
  recordDate   DateTime  @map("record_date")
  nextDueDate  DateTime? @map("next_due_date")
  veterinarian String?
  clinicName   String?   @map("clinic_name")
  documentUrls String[]  @default([]) @map("document_urls")
  createdAt    DateTime  @default(now()) @map("created_at")
  pet          Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("health_records")
}

model PetPreference {
  id              String   @id @default(uuid())
  petId           String   @map("pet_id")
  category        String
  itemId          String?  @map("item_id")
  preferenceScore Int?     @map("preference_score")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("pet_preferences")
}

model UserActivity {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  petId        String?  @map("pet_id")
  activityType String   @map("activity_type")
  itemId       String?  @map("item_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("user_activities")
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  products    Product[]

  @@map("product_categories")
}

model Product {
  id                      String                    @id @default(uuid()) @db.VarChar(255)
  product_code            String?                   @unique @db.VarChar(255)
  name                    String                    @db.VarChar(255)
  brand                   String?                   @db.VarChar(100)
  categoryId              Int?                      @map("category_id")
  category_name           String?                   @db.VarChar(100)
  price                   Decimal                   @db.Decimal(10, 2)
  images                  String[]
  sourcing_url            String?
  selection_reason        String?
  tag                     String?                   @db.VarChar(100)
  margin                  String?                   @db.VarChar(50)
  voc_highlights          String[]
  description             String?
  specs                   Json?
  reviews                 Json?
  is_active               Boolean?                  @default(true)
  createdAt               DateTime?                 @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime?                 @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  product_recommendations product_recommendations[]
  category                ProductCategory?          @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderItems              OrderItem[] // 添加这一行

  @@index([category_name], map: "idx_products_category")
  @@index([price], map: "idx_products_price")
  @@map("products")
}

model product_recommendations {
  id                    Int       @id @default(autoincrement())
  user_id               String?   @db.VarChar(255)
  pet_id                String?   @db.VarChar(255)
  product_id            String?   @db.VarChar(255)
  recommendation_score  Decimal?  @db.Decimal(5, 2)
  recommendation_reason String?
  is_clicked            Boolean?  @default(false)
  is_purchased          Boolean?  @default(false)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  pets                  Pet?      @relation(fields: [pet_id], references: [id], onUpdate: NoAction)
  products              Product?  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 User?     @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([pet_id], map: "idx_product_recommendations_pet")
  @@index([user_id], map: "idx_product_recommendations_user")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  orderNumber     String      @unique @map("order_number")
  status          String      @default("pending") // pending, paid, shipped, delivered, cancelled
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  shippingAddress Json?       @map("shipping_address")
  paymentId       String?     @unique @map("payment_id")
  paymentMethod   String?     @map("payment_method") // alipay, wechat_pay
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}
